{
  "name": "@eco/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Backend de ECO > Eurocamping: catalogo, stock por sucursal, alquiler con disponibilidad por fechas y pedidos",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --experimental-sqlite --watch --import tsx src/index.ts",
    "seed": "node --experimental-sqlite --import tsx src/seed.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
